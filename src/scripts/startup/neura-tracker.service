[Unit]
Description=Hustle Tracker Daemon
After=network.target docker.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hustle_daemon
Restart=always
RestartSec=5
# Ensure environment variables are propagated for Wayland/X11
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=%t
# WAYLAND_DISPLAY will be picked up from the user session if started via graphical-session.target

[Install]
WantedBy=graphical-session.target
